# =========================
# LangChain4j 灰度脚本环境变量模板
# 使用方式：
#   cp scripts/testing/langchain4j-smoke.env.example scripts/testing/langchain4j-smoke.env
#   编辑后执行：./scripts/testing/langchain4j-smoke.sh
# =========================

# 后端健康检查地址（可选）
BACKEND_HEALTH_URL=http://localhost:8088/api/health

# OpenAI（可选，若不配置将跳过）
# OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic（可选，若不配置将跳过）
# ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# MCP 网关（可选，若不配置将跳过）
# MCP_GATEWAY_BASE_URL=http://localhost:8081
# MCP_GATEWAY_API_KEY=default-api-key-1234567890
# 是否将 401 视为“服务可达”（默认 true）
MCP_GATEWAY_ALLOW_401_AS_HEALTHY=true

# PostgreSQL（可选，若不配置将跳过）
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=imagentx
# PGUSER=imagentx_user
# PGPASSWORD=imagentx_pass
