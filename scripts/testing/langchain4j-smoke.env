# LangChain4j 灰度环境（自动回填版）
# 自动策略：
# 1) 优先使用当前 shell/CI 已注入环境变量
# 2) 若没有则留空（脚本自动跳过对应检查，不会失败）
#
# 预发候选（未验证，仅供参考）：
# BACKEND_HEALTH_URL=https://imagentx.top/api/health
# MCP_GATEWAY_BASE_URL=http://<pre-release-host>:8081

# 后端健康检查（可选）
BACKEND_HEALTH_URL="${BACKEND_HEALTH_URL:-}"

# OpenAI（可选，优先 OPENAI_API_KEY；若无则尝试复用 SILICONFLOW_API_KEY）
OPENAI_API_KEY="${OPENAI_API_KEY:-${SILICONFLOW_API_KEY:-}}"
OPENAI_BASE_URL="${OPENAI_BASE_URL:-https://api.openai.com/v1}"
OPENAI_MODEL="${OPENAI_MODEL:-gpt-4o-mini}"

# Anthropic（可选）
ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-https://api.anthropic.com}"
ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-claude-3-5-haiku-latest}"

# MCP 网关（可选）
MCP_GATEWAY_BASE_URL="${MCP_GATEWAY_BASE_URL:-${MCP_GATEWAY_URL:-}}"

# PostgreSQL（可选，优先 PG*，其次尝试 DB_*）
PGHOST="${PGHOST:-${DB_HOST:-}}"
PGPORT="${PGPORT:-${DB_PORT:-5432}}"
PGDATABASE="${PGDATABASE:-${DB_NAME:-}}"
PGUSER="${PGUSER:-${DB_USER:-}}"
PGPASSWORD="${PGPASSWORD:-${DB_PASSWORD:-}}"
