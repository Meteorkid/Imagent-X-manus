{
  "dashboard": {
    "id": null,
    "title": "ImagentX 系统概览",
    "tags": ["imagentx", "overview"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "系统性能概览",
