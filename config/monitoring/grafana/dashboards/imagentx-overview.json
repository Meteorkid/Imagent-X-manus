        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "请求速率"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "displayMode": "gradient"
            }
          }
        }
      }
    ]
  }
}
